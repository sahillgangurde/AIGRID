# ----------------------------------------------------------------------------
# 1. Database & Supabase Cloud Configuration
# ----------------------------------------------------------------------------
# SQLite for local offline development; replace with Supabase Postgres URL for cloud:
DATABASE_URL=sqlite:///./server/data/frame.db

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-anon-key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-anon-key

# Supabase Service Role Secret (Server-side ONLY)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-service-role-key

