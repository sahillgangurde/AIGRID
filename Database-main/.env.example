# ============================================================================
# CreatorSphere AI - Environment Variables Template
# Copy this file to .env.local for local frontend/backend development.
# NEVER commit .env or .env.local to GitHub!
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Supabase Cloud Configuration
# ----------------------------------------------------------------------------
# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (safe to expose in client-side Next.js code)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key-placeholder

# Supabase Service Role Secret (CRITICAL: Server-side only, NEVER in client code!)
# Used by backend webhooks, background jobs, and administrative procedures.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-role-secret-placeholder

# ----------------------------------------------------------------------------
# 2. AI Requirement Assistant Configuration
# ----------------------------------------------------------------------------
# Provider: 'gemini' | 'openai' | 'mock'
AI_PROVIDER=mock

# Google Gemini API Key (keep server-side only)
GEMINI_API_KEY=your-gemini-api-key-placeholder

# Model identifier
AI_MODEL_NAME=gemini-1.5-pro

# ----------------------------------------------------------------------------
# 3. Payment Gateway Configuration (Escrow & Checkout)
# ----------------------------------------------------------------------------
# Provider: 'stripe' | 'razorpay' | 'mock_gateway'
PAYMENT_PROVIDER=mock_gateway

# Stripe Secret API Key (server-side only)
STRIPE_SECRET_KEY=sk_test_placeholder_key

# Stripe Webhook Signing Secret (for verifying incoming webhook signatures)
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

# Razorpay credentials (if using Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# ----------------------------------------------------------------------------
# 4. Storage & Media Buckets
# ----------------------------------------------------------------------------
# Storage Bucket names configured in Supabase Storage dashboard
SUPABASE_PORTFOLIO_BUCKET=portfolio-videos
SUPABASE_AVATARS_BUCKET=avatars
SUPABASE_ATTACHMENTS_BUCKET=chat-attachments

# ----------------------------------------------------------------------------
# 5. Platform Financial Defaults (Configurable)
# ----------------------------------------------------------------------------
# Default platform take rate (e.g. 0.1500 for 15%)
DEFAULT_PLATFORM_FEE_RATE=0.1500

# Default platform currency
DEFAULT_PLATFORM_CURRENCY=USD
